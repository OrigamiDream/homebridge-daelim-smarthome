SMART_ELIFE_EMAIL=your-smart-elife-email
SMART_ELIFE_PASSWORD=your-smart-elife-password

# Legacy alias. SMART_ELIFE_EMAIL takes precedence when both are set.
# SMART_ELIFE_USERNAME=your-smart-elife-email

# Optional. Leave this unset to use the existing deterministic UUID calculation.
# Once wallpad authorization succeeds, keep this value unchanged.
# SMART_ELIFE_UUID=your-fixed-device-uuid
