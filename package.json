{
  "displayName": "Homebridge DL E&C Smart Home",
  "name": "homebridge-daelim-smarthome",
  "version": "1.5.6",
  "description": "A third-party Homebridge platform plugin for DL E&C SmartHome",
  "main": "dist/homebridge/daelim-smarthome-platform.js",
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "daelim",
    "dl e&c",
    "smarthome"
  ],
  "scripts": {
    "assets": "node ./assets/$(ls ./assets | grep .js)",
    "prepare": "npm run build",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc && node ./scripts/copy-homebridge-ui-public.mjs",
    "build:all": "npm run build && npm --prefix frontend run build",
    "check:all": "npm run build && npm --prefix frontend run typecheck && npm --prefix frontend run lint && npm --prefix frontend run build",
    "dashboard:dev": "npm --prefix frontend run dev",
    "dashboard:start": "npm --prefix frontend run start",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "refresh-daelim": "node complexes/daelim/index.js",
    "refresh-smart-elife": "node complexes/smart-elife/index.js",
    "interface": "node homebridge-ui/server.js",
    "deployPi": "npm run build && python3 scripts/deploy.py"
  },
  "author": "OrigamiDream <hello@origamidream.me>",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0 || ^2.0.0-alpha.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrigamiDream/homebridge-daelim-smarthome.git"
  },
  "bugs": {
    "url": "https://github.com/OrigamiDream/homebridge-daelim-smarthome/issues"
  },
  "devDependencies": {
    "@types/node": "14.18.63",
    "@types/node-fetch": "2.5.8",
    "@types/readline-sync": "1.4.3",
    "@types/ws": "8.18.1",
    "canvas": "3.2.1",
    "homebridge": "2.0.1",
    "rimraf": "3.0.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@eneris/push-receiver": "4.2.0",
    "@homebridge/plugin-ui-utils": "0.0.19",
    "axios": "1.18.0",
    "ffmpeg-for-homebridge": "2.2.1",
    "node-fetch": "2.6.7",
    "pick-port": "1.0.1",
    "readline-sync": "1.4.10",
    "ws": "8.21.0"
  },
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/OrigamiDream"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/OrigamiDream"
    },
    {
      "type": "toss",
      "url": "https://toss.me/steinway"
    }
  ]
}
